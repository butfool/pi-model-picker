{
  "name": "@butfool/pi-model-picker",
  "version": "0.1.0",
  "description": "Three-pane model picker for Pi: provider list, model list, and an inspector with per-model thinking levels",
  "type": "module",
  "license": "MIT",
  "author": "butfool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/butfool/pi-model-picker.git"
  },
  "homepage": "https://github.com/butfool/pi-model-picker#readme",
  "bugs": {
    "url": "https://github.com/butfool/pi-model-picker/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "model-picker",
    "model-selector",
    "thinking-level"
  ],
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "uv run --with pexpect python tests/picker_test.py"
  },
  "engines": {
    "node": ">=22"
  }
}
